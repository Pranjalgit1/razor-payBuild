# ---------------------------------------------------------------------------
# RevenueRecover AI — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL (target database — matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg://revenue:revenue@localhost:5433/revenuerecover
# Zero-infrastructure fallback for local demo runs:
# DATABASE_URL=sqlite+pysqlite:///./revenuerecover.db

# --- AI provider -----------------------------------------------------------
# "xai" (or "grok") = live Grok API; "anthropic" = live Claude API;
# "rules" = deterministic offline agent. Put credentials only in .env.
AI_PROVIDER=anthropic
XAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional global override. Leave empty for provider defaults:
# xAI=grok-4.6, Anthropic=claude-opus-5.
AGENT_MODEL=
XAI_MODEL=grok-4.6
ANTHROPIC_MODEL=claude-opus-5

# Bounded provider execution. The backend rejects runs exceeding these limits.
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_TURNS=6
AGENT_MAX_TOOL_CALLS=8

# --- Recovery policy limits (enforced by the backend, not by the AI) -------
MAX_PAYMENT_RETRIES=2
MAX_REMINDERS=3
CONTACT_COOLDOWN_HOURS=24
# Amounts in paise. 5000000 paise = INR 50,000.
ESCALATION_AMOUNT_THRESHOLD=5000000
HIGH_VALUE_LTV_THRESHOLD=5000000

# --- Frontend --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
